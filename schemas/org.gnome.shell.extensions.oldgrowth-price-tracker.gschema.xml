    <key type="s" name="vs-currency">
      <default>'usd'</default>
      <summary>Fiat / quote currency</summary>
      <description>Quote currency (usd, eur, …).</description>
    </key>
    <key type="i" name="refresh-interval">
      <default>30</default>
      <summary>Refresh interval (seconds)</summary>
      <description>How often to refresh prices. Minimum 20s.</description>
    </key>
    <key type="b" name="show-icons">
      <default>true</default>
