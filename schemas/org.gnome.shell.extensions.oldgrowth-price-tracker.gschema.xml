    </key>
    <key type="b" name="show-tickers">
      <default>true</default>
      <summary>Show ticker names on the top bar</summary>
      <description>When false, only icons and/or prices are shown.</description>
    </key>
    <key type="b" name="colorize-prices">
      <default>false</default>
      <summary>Color prices green/red by 24h change</summary>
      <description>When false, all panel prices stay white. When true, up=green and down=red.</description>
    </key>
    <key type="b" name="auto-compact">
      <default>true</default>
